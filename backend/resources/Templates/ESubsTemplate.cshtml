@using System

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Successful</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #4CAF50; color: white; padding: 20px; text-align: center; }
        .content { background-color: #f9f9f9; padding: 20px; margin-top: 20px; }
        .footer { margin-top: 20px; text-align: center; font-size: 12px; color: #777; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Thank You for Subscribing!</h1>
        </div>
        <div class="content">
            <p>Hello,</p>
            <p>Thank you for subscribing to the <strong>ZCommerce</strong> newsletter!</p>
            <p>You'll now receive the latest updates, exclusive offers, and news directly to your inbox.</p>
            <p>If you have any questions or wish to manage your subscription, contact us at <a href="mailto:support@zcommerce.com">support@zcommerce.com</a>.</p>
            <p>We're glad to have you with us!</p>
            <p>Best regards,<br />The ZCommerce Team</p>
        </div>
        <div class="footer">
            <p>&copy; @DateTime.UtcNow.Year ZCommerce. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
