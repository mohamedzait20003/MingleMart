{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "URL": "http://localhost:3000"
  },
  "MongoDB": {
    "ConnectionURI": "<Atlas connection string>",
    "DatabaseName": "sample_mflix"
  },
  "Jwt": {
    "Key": "your-super-secret-jwt-key-at-least-32-characters-long",
    "Issuer": "YourAppName",
    "Audience": "YourAppUsers"
  },
  "Google": {
    "ClientId": "your-google-client-id.apps.googleusercontent.com"
  },
  "MailSettings": {
    "Server": "smtp.your-server.com",
    "Port": 587,
    "SenderName": "Your App Name",
    "SenderEmail": "noreply@yourapp.com",
    "UserName": "your-smtp-username",
    "Password": "your-smtp-password"
  },
  "Cloudinary": {
    "URI": "cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>"
  },
  "GeoIP": {
    "AccountId": 123456,
    "LicenseKey": "your-geoip-license-key"
  }
}
