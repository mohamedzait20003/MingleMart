# ---------------------------------------------------------------------------
# Backend environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Spring reads this file directly, via `spring.config.import` in
# application.properties. No dotenv library needed.
#
# It is parsed as a PROPERTIES file, which has two consequences:
#   * Keys are taken literally. UPPER_SNAKE names work because
#     application.properties looks them up as ${NAME} placeholders.
#   * Spring's own settings must use their real dotted names, NOT the
#     SPRING_DATASOURCE_URL env-var spelling — relaxed binding applies to real
#     environment variables, not to keys in a property source.
#
# Real environment variables take precedence over this file, so an exported
# value overrides what is checked out here.
#
# Docker Compose also reads this file for ${VAR} substitution in compose.yaml,
# though compose.yaml currently hardcodes its values.
# ---------------------------------------------------------------------------

# --- tokens -----------------------------------------------------------------
# HMAC key for signing access-token JWTs. MUST be at least 32 bytes or the app
# refuses to start (HS256 requires it). Generate a fresh one per environment:
#   openssl rand -base64 48
# Rotating this invalidates every outstanding access token. Refresh tokens
# survive, because they are opaque rows in `sessions` rather than signed data.
MINGLEMART_TOKEN_SECRET=change-me-this-must-be-at-least-32-bytes-long

# --- oauth ------------------------------------------------------------------
# Google OAuth client id. Checked as the `aud` claim on every ID token, which is
# what stops a token minted for a different application being accepted here.
# Leave it unset and Google sign-in rejects everything (deliberate).
# Must match VITE_GOOGLE_CLIENT_ID in ../../frontend/.env
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# --- frontend & cors --------------------------------------------------------
# Where the browser app is served from. Used to build emailed links AND, by
# default, as the one browser origin allowed to call this API.
FRONTEND_URL=http://localhost:5173

# Override only when more than one origin needs access — a preview build, or a
# separately hosted SSR server. Comma-separated, and each entry must be an exact
# origin: the session lives in cookies, and browsers reject a wildcard origin on
# any request that carries credentials.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- observability ----------------------------------------------------------
# Logs one line per request: method, path, status, duration. Handy while
# watching a dev stack, noise anywhere else, so it defaults to false.
# compose.yaml turns it on for the containerised stack.
# HTTP_LOG_REQUESTS=true

# --- database ---------------------------------------------------------------
# Only needed when pointing at a database you manage yourself. In development
# the Docker Compose Support starter reads compose.yaml, starts the Postgres
# service and injects these three for you — leave them commented out.
# spring.datasource.url=jdbc:postgresql://localhost:5432/minglemart
# spring.datasource.username=minglemart
# spring.datasource.password=secret

# --- redis ------------------------------------------------------------------
# Backs shared.infra.RedisStore, which caches the storefront reads. In
# development the Docker Compose Support starter injects these from compose.yaml
# the same way it does the datasource, so leave them alone. Set them when
# pointing at a Redis you manage yourself.
#
# Losing Redis is not an outage: RedisStore fails open, so every read falls
# through to the database and the pages are simply slower.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- server -----------------------------------------------------------------
# server.port=8080
