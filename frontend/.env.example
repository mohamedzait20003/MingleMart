# ---------------------------------------------------------------------------
# Frontend environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Vite reads this directory automatically. Only variables prefixed with VITE_
# are exposed to client code, and they are INLINED INTO THE BUNDLE at build
# time — treat every value here as public. Never put a secret in this file.
# ---------------------------------------------------------------------------

# Base URL of the MingleMart API, without a trailing slash.
# The RTK Query base query appends its own path segments (`/auth`, ...).
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth *client* id (public by design — it identifies the app, it does
# not authenticate it). Must be the SAME value as GOOGLE_CLIENT_ID on the
# backend: the backend checks it as the `aud` claim of every ID token, so a
# mismatch makes every Google sign-in fail with INVALID_GOOGLE_TOKEN.
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Port the SSR server listens on. Read by server/prod.ts only; the dev server
# is fixed at 5173.
PORT=5173
