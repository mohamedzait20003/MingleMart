{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "src/server",
    // Data, so the Node project can read the same cookie names the browser does.
    "src/common/data/cookies.json"
  ]
}
