.DS_Store
Thumbs.db
*.log

# ===========================
# Backend (.NET / ASP.NET Core + Console projects)
# ===========================
# Build artifacts (main project + console apps)
backend/bin/
backend/obj/
backend/console/**/bin/
backend/console/**/obj/
backend/**/publish/
backend/**/[Bb]in/
backend/**/[Oo]bj/
backend/**/[Pp]ublish/

# NuGet restore files
backend/**/*.nuget.dgspec.json
backend/**/*.nuget.g.props
backend/**/*.nuget.g.targets
backend/**/project.assets.json
backend/**/project.fragment.lock.json
backend/**/project.lock.json

# Visual Studio / Rider
backend/.vs/
backend/.vscode/
backend/.idea/
backend/**/*.user
backend/**/*.suo
backend/**/*.userosscache
backend/**/*.sln.docstates
backend/**/*.pidb
backend/**/*.userprefs
backend/**/.idea/

# User-specific files
*.rsuser
backend/**/*.sln.iml

# Runtime files
backend/**/*.dll
backend/**/*.exe
backend/**/*.pdb
backend/**/*.deps.json
backend/**/*.runtimeconfig.json
backend/**/*.staticwebassets.runtime.json
backend/**/*.staticwebassets.endpoints.json

# Environment and secrets
backend/.env
backend/.env.*
backend/**/*.secrets.json

# Production-specific configs (keep Development for team consistency)
backend/**/appsettings.Production.json
backend/**/appsettings.Staging.json

# Database files
backend/**/database/migrations/*.sql
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal

# NuGet packages
backend/**/packages/
*.nupkg
*.snupkg

